<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">
  <persistence-unit name="post_unit">

    <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>


      <class>org.example.project_post_jakarta.entity.Post</class>
      <class>org.example.project_post_jakarta.entity.User</class>
      <class>org.example.project_post_jakarta.entity.Like</class>
      <class>org.example.project_post_jakarta.entity.View</class>


    <properties>

      <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/postgres"/>
      <property name="jakarta.persistence.jdbc.user" value="postgres"/>
      <property name="jakarta.persistence.jdbc.password" value="qazwsx"/>
      <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>

      <property name="jakarta.persistence.schema-generation.database.action" value="update"/>

      <property name="hibernate.show_sql" value="true"/>

    </properties>

  </persistence-unit>
</persistence>
